---
interface Props {
  completed?: number;
  total?: number;
}
const { completed = 3, total = 8 } = Astro.props;
const percentage = Math.round((completed / total) * 100);
---

<div class="space-y-2 mb-10 px-2">
  <div class="flex items-center justify-between text-sm font-medium">
    <span class="text-text-main font-semibold">Daily Progress</span>
    <span class="text-text-muted">{completed} of {total} sessions</span>
  </div>
  <div class="h-3 w-full bg-black/5 rounded-full overflow-hidden">
    <div class="h-full bg-brand-primary rounded-full transition-all duration-500" style={`width: ${percentage}%`}></div>
  </div>
</div>
