---
import SessionCard from './SessionCard.astro';
---

<div class="bg-surface-card border border-border-subtle rounded-3xl p-6 shadow-sm space-y-6">
  <!-- Top Handle / Indicator bar -->
  <div class="w-10 h-1 bg-border-subtle rounded-full mx-auto -mt-2"></div>

  <!-- Segmented Filter Tabs -->
  <div class="flex items-center gap-2 p-1.5 bg-surface-panel rounded-full max-w-xs">
    <button class="flex-1 py-2 px-4 rounded-full bg-text-main text-surface-card text-xs font-semibold shadow-sm transition-all">
      All
    </button>
    <button class="flex-1 py-2 px-4 rounded-full text-text-muted text-xs font-semibold hover:text-text-main transition-all relative flex items-center justify-center gap-1">
      <span>New (3)</span>
      <span class="w-1.5 h-1.5 rounded-full bg-brand-accent"></span>
    </button>
  </div>

  <!-- Agenda Sub-header -->
  <div class="flex items-center justify-between pt-2">
    <h3 class="text-base font-semibold text-text-main">Earlier today</h3>
    <span class="text-xs text-text-muted flex items-center gap-1 cursor-pointer">
      2 events ▾
    </span>
  </div>

  <!-- Daily Sessions List -->
  <div class="space-y-3">
    <SessionCard
      title="Product Design Demo"
      startTime="12:00"
      endTime="13:30"
      statusColor="bg-brand-primary"
      metadata="Kinetotherapy Session • Room A"
    />
    <SessionCard
      title="Focus Time"
      startTime="14:00"
      endTime="16:00"
      statusColor="bg-brand-accent"
      metadata="Patient Evaluation & Prep"
    />
  </div>
</div>
