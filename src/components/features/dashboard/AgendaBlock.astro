---
import SessionCard from './SessionCard.astro';
---

<div class="bg-surface-card rounded-3xl p-8 shadow-sm space-y-8">
  <!-- Segmented Filter Tabs -->
  <div class="flex items-center gap-2 p-1 bg-surface-panel rounded-full max-w-[200px]">
    <button class="flex-1 py-2 px-4 rounded-full bg-text-main text-surface-card text-xs font-medium transition-all">
      All
    </button>
    <button class="flex-1 py-2 px-4 rounded-full text-text-muted text-xs font-medium hover:text-text-main transition-all flex items-center justify-center">
      History
    </button>
  </div>

  <!-- Daily Sessions List -->
  <div class="space-y-4">
    <SessionCard
      title="Kinetotherapy Session"
      startTime="12:00"
      endTime="13:30"
      metadata="Patient: Maria Ionescu • Recovery"
    />
    <SessionCard
      title="Evaluation & Prep"
      startTime="14:00"
      endTime="16:00"
      metadata="Initial Physical Assessment"
    />
  </div>
</div>
