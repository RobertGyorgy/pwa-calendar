---
interface Props {
  title: string;
  startTime: string;
  endTime: string;
  metadata?: string;
}

const { title, startTime, endTime, metadata } = Astro.props;
---

<div class="bg-surface-panel rounded-2xl p-4.5 flex items-center justify-between">
  <div>
    <h4 class="text-base font-semibold text-text-main leading-snug">{title}</h4>
    {metadata && <p class="text-xs text-text-muted mt-1 font-normal">{metadata}</p>}
  </div>
  <div class="text-right shrink-0">
    <span class="block text-sm font-medium text-text-main">{startTime}</span>
    <span class="block text-xs text-text-muted">{endTime}</span>
  </div>
</div>
