---
interface Props {
  title: string;
  startTime: string;
  endTime: string;
  statusColor?: string;
  metadata?: string;
}

const { title, startTime, endTime, statusColor = 'bg-brand-primary', metadata } = Astro.props;
---

<div class="bg-surface-panel rounded-2xl p-4 flex items-center justify-between border border-border-subtle hover:border-border-strong transition-colors">
  <div class="flex items-center gap-3">
    <!-- Left Status Accent Bar -->
    <div class={`w-1.5 h-10 rounded-full ${statusColor}`}></div>
    <div>
      <h4 class="text-base font-semibold text-text-main leading-snug">{title}</h4>
      {metadata && <p class="text-xs text-text-muted mt-0.5">{metadata}</p>}
    </div>
  </div>
  <div class="text-right shrink-0">
    <span class="block text-sm font-semibold text-text-main">{startTime}</span>
    <span class="block text-xs text-text-muted">{endTime}</span>
  </div>
</div>
