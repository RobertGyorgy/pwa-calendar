---
interface Props {
  name?: string;
}

const { name = "Dr. Maria" } = Astro.props;

const days = [
  { day: 'M', date: 7, active: false },
  { day: 'T', date: 8, active: false },
  { day: 'W', date: 9, active: true },
  { day: 'T', date: 10, active: false },
  { day: 'F', date: 11, active: false },
  { day: 'S', date: 12, active: false },
  { day: 'S', date: 13, active: false },
];
---

<div class="bg-surface-card rounded-3xl p-8 shadow-sm">
  <!-- Greeting Header & Action -->
  <div class="flex items-center justify-between mb-8">
    <h2 class="text-4xl font-semibold tracking-tight text-text-main">Hello, {name}</h2>
    
    <button aria-label="Add appointment" class="w-11 h-11 rounded-full bg-text-main text-surface-card flex items-center justify-center text-xl font-medium active:scale-95 transition-transform shrink-0">
      +
    </button>
  </div>

  <!-- Vertical Capsule Calendar Strip -->
  <div class="grid grid-cols-7 gap-1 text-center">
    {days.map((item) => (
      item.active ? (
        <button class="flex flex-col items-center justify-between rounded-full py-2 px-1 bg-amber-400 text-white active:scale-95 transition-transform shadow-md h-20">
          <span class="text-xs font-medium mt-1">{item.day}</span>
          <span class="w-8 h-8 rounded-full bg-white text-black flex items-center justify-center text-base font-semibold">
            {item.date}
          </span>
        </button>
      ) : (
        <button class="flex flex-col items-center justify-between rounded-full py-2 px-1 text-text-main hover:bg-surface-panel active:scale-95 transition-transform h-20">
          <span class="text-xs font-medium text-text-muted mt-1">{item.day}</span>
          <span class="text-base font-medium mb-1.5">{item.date}</span>
        </button>
      )
    ))}
  </div>
</div>
