---
import { NAV_ITEMS } from '../../lib/constants';

const currentPath = Astro.url.pathname;
---

<nav
  id="dock-nav"
  class="fixed bottom-6 left-1/2 -translate-x-1/2 z-50 rounded-full px-3 py-2 border border-border-subtle bg-surface-card/85 backdrop-blur-xl shadow-2xl flex items-center gap-1 transition-all"
>
  <!-- Animated Sliding Active Pill Background -->
  <div
    id="dock-active-pill"
    class="absolute top-2 bottom-2 rounded-full bg-brand-primary/15 transition-all duration-300 ease-out pointer-events-none"
    style="left: 0; width: 0;"
  ></div>

  {NAV_ITEMS.map((item, index) => {
    const isActive = currentPath === item.path || (item.path !== '/dashboard' && currentPath.startsWith(item.path));
    return (
      <a
        href={item.path}
        data-dock-item
        data-active={isActive ? "true" : "false"}
        data-index={index}
        class={`relative z-10 flex flex-col items-center justify-center min-w-[56px] min-h-[44px] px-3 py-1.5 rounded-full text-xs font-medium transition-colors active:scale-95 ${
          isActive ? 'text-brand-primary font-semibold' : 'text-text-muted hover:text-text-main'
        }`}
      >
        <span class="capitalize leading-none">{item.name}</span>
      </a>
    );
  })}
</nav>

<script>
  import { gsap } from 'gsap';

  function initDockAnimation() {
    const dockNav = document.getElementById('dock-nav');
    const activePill = document.getElementById('dock-active-pill');
    if (!dockNav || !activePill) return;

    const items = dockNav.querySelectorAll('[data-dock-item]');
    let activeItem: HTMLElement | null = null;

    items.forEach((item) => {
      if (item.getAttribute('data-active') === 'true') {
        activeItem = item as HTMLElement;
      }
    });

    if (!activeItem && items.length > 0) {
      activeItem = items[0] as HTMLElement;
    }

    if (activeItem) {
      const dockRect = dockNav.getBoundingClientRect();
      const itemRect = activeItem.getBoundingClientRect();
      const relativeLeft = itemRect.left - dockRect.left;

      gsap.to(activePill, {
        left: relativeLeft,
        width: itemRect.width,
        duration: 0.35,
        ease: 'power2.out',
      });
    }

    items.forEach((item) => {
      item.addEventListener('mouseenter', () => {
        const dockRect = dockNav.getBoundingClientRect();
        const itemRect = item.getBoundingClientRect();
        const relativeLeft = itemRect.left - dockRect.left;

        gsap.to(activePill, {
          left: relativeLeft,
          width: itemRect.width,
          duration: 0.25,
          ease: 'power1.out',
        });
      });
    });

    dockNav.addEventListener('mouseleave', () => {
      if (activeItem) {
        const dockRect = dockNav.getBoundingClientRect();
        const itemRect = activeItem.getBoundingClientRect();
        const relativeLeft = itemRect.left - dockRect.left;

        gsap.to(activePill, {
          left: relativeLeft,
          width: itemRect.width,
          duration: 0.35,
          ease: 'power2.out',
        });
      }
    });
  }

  // Run on initial load and after Astro View Transitions page swaps
  document.addEventListener('DOMContentLoaded', initDockAnimation);
  document.addEventListener('astro:page-load', initDockAnimation);
</script>
