---
import { NAV_ITEMS } from '../../lib/constants';

const currentPath = Astro.url.pathname;

// SVG Icons mapping for 5 navigation routes
const icons = {
  home: `<svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 12l2-2m0 0l7-7 7 7M5 10v10a1 1 0 001 1h3m10-11l2 2m-2-2v10a1 1 0 01-1 1h-3m-6 0a1 1 0 001-1v-4a1 1 0 011-1h2a1 1 0 011 1v4a1 1 0 001 1m-6 0h6"/></svg>`,
  calendar: `<svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 7V3m8 4V3m-9 8h10M5 21h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v12a2 2 0 002 2z"/></svg>`,
  patients: `<svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 4.354a4 4 0 110 5.292M15 21H3v-1a6 6 0 0112 0v1zm0 0h6v-1a6 6 0 00-9-5.197M13 7a4 4 0 11-8 0 4 4 0 018 0z"/></svg>`,
  reports: `<svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 19v-6a2 2 0 00-2-2H5a2 2 0 00-2 2v6a2 2 0 002 2h2a2 2 0 002-2zm0 0V9a2 2 0 012-2h2a2 2 0 012 2v10m-6 0a2 2 0 002 2h2a2 2 0 002-2m0 0V5a2 2 0 012-2h2a2 2 0 012 2v14a2 2 0 01-2 2h-2a2 2 0 01-2-2z"/></svg>`,
  settings: `<svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10.325 4.317c.426-1.756 2.924-1.756 3.35 0a1.724 1.724 0 002.573 1.066c1.543-.94 3.31.826 2.37 2.37a1.724 1.724 0 001.065 2.572c1.756.426 1.756 2.924 0 3.35a1.724 1.724 0 00-1.066 2.573c.94 1.543-.826 3.31-2.37 2.37a1.724 1.724 0 00-2.572 1.065c-.426 1.756-2.924 1.756-3.35 0a1.724 1.724 0 00-2.573-1.066c-1.543.94-3.31-.826-2.37-2.37a1.724 1.724 0 00-1.065-2.572c-1.756-.426-1.756-2.924 0-3.35a1.724 1.724 0 001.066-2.573c-.94-1.543.826-3.31 2.37-2.37.996.608 2.296.07 2.572-1.065z"/><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 12a3 3 0 11-6 0 3 3 0 016 0z"/></svg>`
};
---

<nav
  id="dock-nav"
  class="fixed bottom-6 left-1/2 -translate-x-1/2 z-50 w-fit rounded-full px-3 py-2 bg-surface-card/80 backdrop-blur-xl border border-white/30 dark:border-white/10 shadow-lg shadow-black/5 flex items-center gap-1.5 transition-all"
>
  <!-- Animated Sliding Active Pill Background -->
  <div
    id="dock-active-pill"
    class="absolute top-1.5 bottom-1.5 rounded-full bg-text-main/10 transition-all duration-300 ease-out pointer-events-none"
    style="left: 0; width: 0;"
  ></div>

  {NAV_ITEMS.map((item, index) => {
    const isActive = currentPath === item.path || (item.path !== '/dashboard' && currentPath.startsWith(item.path));
    return (
      <a
        href={item.path}
        data-dock-item
        data-active={isActive ? "true" : "false"}
        data-index={index}
        aria-label={item.name}
        class={`relative z-10 flex items-center justify-center w-11 h-11 rounded-full transition-colors active:scale-90 ${
          isActive ? 'text-text-main' : 'text-text-muted hover:text-text-main'
        }`}
      >
        <Fragment set:html={icons[item.iconName]} />
      </a>
    );
  })}
</nav>

<script>
  import { gsap } from 'gsap';

  function initDockAnimation() {
    const dockNav = document.getElementById('dock-nav');
    const activePill = document.getElementById('dock-active-pill');
    if (!dockNav || !activePill) return;

    const items = dockNav.querySelectorAll('[data-dock-item]');
    let activeItem: HTMLElement | null = null;

    items.forEach((item) => {
      if (item.getAttribute('data-active') === 'true') {
        activeItem = item as HTMLElement;
      }
    });

    if (!activeItem && items.length > 0) {
      activeItem = items[0] as HTMLElement;
    }

    if (activeItem) {
      const dockRect = dockNav.getBoundingClientRect();
      const itemRect = activeItem.getBoundingClientRect();
      const relativeLeft = itemRect.left - dockRect.left;

      gsap.to(activePill, {
        left: relativeLeft,
        width: itemRect.width,
        duration: 0.35,
        ease: 'power2.out',
      });
    }

    items.forEach((item) => {
      item.addEventListener('mouseenter', () => {
        const dockRect = dockNav.getBoundingClientRect();
        const itemRect = item.getBoundingClientRect();
        const relativeLeft = itemRect.left - dockRect.left;

        gsap.to(activePill, {
          left: relativeLeft,
          width: itemRect.width,
          duration: 0.25,
          ease: 'power1.out',
        });
      });
    });

    dockNav.addEventListener('mouseleave', () => {
      if (activeItem) {
        const dockRect = dockNav.getBoundingClientRect();
        const itemRect = activeItem.getBoundingClientRect();
        const relativeLeft = itemRect.left - dockRect.left;

        gsap.to(activePill, {
          left: relativeLeft,
          width: itemRect.width,
          duration: 0.35,
          ease: 'power2.out',
        });
      }
    });
  }

  document.addEventListener('DOMContentLoaded', initDockAnimation);
  document.addEventListener('astro:page-load', initDockAnimation);
</script>
