---
interface Props {
  title: string;
}

const { title } = Astro.props;
---

<header class="h-16 bg-surface-card border-b border-border-subtle px-6 flex items-center justify-between">
  <h1 class="text-xl font-semibold text-text-main">{title}</h1>
  <div class="flex items-center gap-3">
    <span class="text-xs px-2.5 py-1 rounded-full bg-brand-accent/10 text-brand-accent font-medium">
      Kinetotherapist Mode
    </span>
  </div>
</header>
