---
import { ROUTES } from '../../lib/constants';

const navItems = [
  { name: 'Overview', path: ROUTES.DASHBOARD },
  { name: 'Calendar / Agenda', path: ROUTES.AGENDA },
  { name: 'Patients', path: ROUTES.PATIENTS },
  { name: 'Reports', path: '/dashboard/reports' },
  { name: 'Settings', path: '/dashboard/settings' },
];
---

<aside class="w-full md:w-64 bg-surface-card border-r border-border-subtle p-4 flex flex-col justify-between">
  <div>
    <div class="flex items-center gap-2 mb-8 px-2">
      <div class="w-8 h-8 rounded-lg bg-brand-primary flex items-center justify-center text-text-inverse font-bold">
        K
      </div>
      <span class="font-bold text-lg text-text-main">KinetoApp</span>
    </div>
    <nav class="space-y-1">
      {navItems.map((item) => (
        <a
          href={item.path}
          class="flex items-center px-3 py-2 text-sm font-medium rounded-md text-text-muted hover:bg-surface-panel hover:text-text-main transition-colors"
        >
          {item.name}
        </a>
      ))}
    </nav>
  </div>
  <div class="pt-4 border-t border-border-subtle px-2">
    <a href={ROUTES.LOGIN} class="text-sm text-text-muted hover:text-state-danger transition-colors">
      Sign Out
    </a>
  </div>
</aside>
