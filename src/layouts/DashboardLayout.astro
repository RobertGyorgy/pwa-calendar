---
import Sidebar from '../components/layout/Sidebar.astro';
import Header from '../components/layout/Header.astro';
import BottomNav from '../components/layout/BottomNav.astro';
import '../styles/global.css';

interface Props {
  title: string;
}

const { title } = Astro.props;
---

<!DOCTYPE html>
<html lang="en" class="h-full bg-surface-base">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=1.0, user-scalable=no, viewport-fit=cover" />
    <meta name="theme-color" content="#0d9488" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="manifest" href="/manifest.json" />
    <title>{title} | Kineto Agenda</title>
  </head>
  <body class="h-full font-sans text-text-main antialiased selection:bg-brand-primary/20">
    <div class="min-h-full flex flex-col md:flex-row">
      <!-- Persistent Left Sidebar for Desktop (>= 768px) -->
      <Sidebar />

      <div class="flex-1 flex flex-col min-w-0 pb-20 md:pb-0">
        <!-- Top Navigation Header -->
        <Header title={title} />

        <!-- Main Content Area -->
        <main class="flex-1 p-4 md:p-6 overflow-y-auto">
          <slot />
        </main>
      </div>

      <!-- Fixed Bottom Navigation Bar for Mobile (< 768px) -->
      <BottomNav />
    </div>
  </body>
</html>
