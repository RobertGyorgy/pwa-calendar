---
import DashboardLayout from '../../layouts/DashboardLayout.astro';
import AgendaView from '../../components/features/calendar/AgendaView.astro';
---

<DashboardLayout title="Agenda & Calendar">
  <section class="space-y-6">
    <header class="flex items-center justify-between">
      <div>
        <h2 class="text-2xl font-bold text-text-main">Appointment Agenda</h2>
        <p class="text-sm text-text-muted mt-1">Manage session times and automated patient push reminders</p>
      </div>
    </header>
    <AgendaView />
  </section>
</DashboardLayout>
