---
import DashboardLayout from '../../layouts/DashboardLayout.astro';
import PatientList from '../../components/features/patients/PatientList.astro';
---

<DashboardLayout title="Patients">
  <section class="space-y-6">
    <header class="flex items-center justify-between">
      <div>
        <h2 class="text-2xl font-bold text-text-main">Patient Directory</h2>
        <p class="text-sm text-text-muted mt-1">Manage patient files, medical history, and contact details</p>
      </div>
    </header>
    <PatientList />
  </section>
</DashboardLayout>
